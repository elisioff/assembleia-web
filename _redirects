# Devices with the app open /iniciativa/:id directly (universal/app link) and never
# hit this. Everyone else gets the landing page, which loads the initiative and
# points to the stores. 200 = rewrite (keeps the URL so the page can read the id).
# The worker (worker.js, run_worker_first) normally handles /iniciativa/* before
# assets; this rule is the fallback if the worker isn't attached.
/iniciativa/*  /iniciativa-app  200
/deputado/*    /deputado-app    200
# Digest notification links (/novidades?partido=…) are opened by the apps only;
# a browser goes home. The worker doesn't run on this path, so this rule is it.
/novidades     /                302
