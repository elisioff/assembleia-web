// Config for the Cloudflare Workers git deploy (`npx wrangler deploy`).
// The name must stay "assembleia-web" — it targets the existing Worker that
// owns the assembleiaapp.com domain.
{
  "name": "assembleia-web",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The worker only sees these routes; every other path is served straight
    // from the static assets (including the _redirects fallback).
    "run_worker_first": ["/iniciativa/*"]
  }
}
